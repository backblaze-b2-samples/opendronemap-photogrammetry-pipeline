  "info": {
    "description": "Local API for the OpenDroneMap Photogrammetry Pipeline: ingest drone image sets, run OpenDroneMap reconstructions, and manage the resulting orthomosaics, DEMs, point clouds, and 3D meshes on Backblaze B2. This contract documents the local API, not a hosted public endpoint.",
    "title": "OpenDroneMap Photogrammetry Pipeline API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/config": {
      "get": {
        "description": "Non-secret bucket coordinates the UI needs to build S3 URIs for artifacts.\n\nBucket name and region are not credentials; they let the mission artifact\nexplorer render a copy-able ``s3://<bucket>/<key>`` URI for downstream GIS\npipelines without hardcoding the bucket in the frontend.",
        "operationId": "config_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Config",
        "tags": [
          "health"
        ]
      }
    },
    "/files": {
      "get": {
        "operationId": "list_files_endpoint_files_get",
        "parameters": [
          {
            "in": "query",
            "name": "prefix",
            "required": false,
            "schema": {
              "default": "",
              "title": "Prefix",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FileMetadata"
                  },
                  "title": "Response List Files Endpoint Files Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Files Endpoint",
        "tags": [
          "files"
        ]
      }
    },
    "/files-by-key": {
      "delete": {
        "operationId": "delete_file_by_key_endpoint_files_by_key_delete",
